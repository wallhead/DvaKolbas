    target_link_libraries(TRPXessFgLifecycleTests PRIVATE TRPXessGeneration)
    add_dependencies(TRPXessFgLifecycleTests TRPXessFgDouble_generation TRPXessFgDouble_latency)
    add_test(NAME XessFgLifecycle COMMAND TRPXessFgLifecycleTests "${CMAKE_CURRENT_BINARY_DIR}/xess-fg-fixtures/good")
    set_tests_properties(XessFgLifecycle PROPERTIES LABELS GPU RUN_SERIAL TRUE TIMEOUT 60 SKIP_RETURN_CODE 77)
    add_test(NAME XessFgPackage COMMAND pwsh.exe -NoProfile -File "${PROJECT_SOURCE_DIR}/tests/XessFgPackageTests.ps1" -SdkDirectory "${TRP_XESS_SDK_DIR}" -ScratchRoot "${CMAKE_CURRENT_BINARY_DIR}/xess-fg-package-fixtures")
    set_tests_properties(XessFgPackage PROPERTIES TIMEOUT 60)
endfunction()
function(trp_add_xess_fg_source_tests)
    if(NOT TRP_ENABLE_XESS_FG OR NOT TARGET TRPXessRuntime OR NOT TARGET TRPFsrRuntime OR NOT TARGET TRPNeuralRuntime)
        return()
    endif()
    set(TRP_XESS_FG_FSR_PLUGIN_DIRECTORY "" CACHE PATH "Pinned FSR 3.1.5 plugin fixture for Intel FG source probe")
    if(NOT TRP_XESS_FG_FSR_PLUGIN_DIRECTORY OR NOT TRP_NR_TEST_RUNTIME_ROOT OR NOT TRP_NR_DRIVER_CORE)
        return()
    endif()
    add_executable(TRPXessFgSourceGpuTests tests/xess-fg/XessFgSourceGpuTests.cpp)
    target_include_directories(TRPXessFgSourceGpuTests PRIVATE tests)
    target_link_libraries(TRPXessFgSourceGpuTests PRIVATE TRPXessGeneration TRPXessRuntime TRPFsrRuntime TRPNeuralRuntime user32 bcrypt)
    add_test(NAME XessFgSourceGpu COMMAND TRPXessFgSourceGpuTests "${TRP_XESS_SDK_DIR}/SKSE/Plugins" "${TRP_NR_TEST_RUNTIME_ROOT}" "${TRP_NR_DRIVER_CORE}" "${TRP_XESS_FG_FSR_PLUGIN_DIRECTORY}")
    set_tests_properties(XessFgSourceGpu PROPERTIES LABELS GPU RUN_SERIAL TRUE TIMEOUT 240 SKIP_RETURN_CODE 77)
endfunction()
