#pragma once

#include <string_view>

namespace Plugin
{
	using namespace std::literals;

	inline constexpr REL::Version VERSION
	{
		// clang-format off
		@PROJECT_VERSION_MAJOR@u,
		@PROJECT_VERSION_MINOR@u,
		@PROJECT_VERSION_PATCH@u,
		// clang-format on
	};

	// Retained SKSE identity also controls log filenames and existing tooling.
	inline constexpr auto NAME = "@TRP_PLUGIN_TARGET@"sv;
	inline constexpr auto VERSION_STRING = "@PROJECT_VERSION@"sv;
	inline constexpr auto DISPLAY_NAME = "@TRP_DISPLAY_NAME@"sv;
	inline constexpr auto RELEASE_VERSION = "@ARP_RELEASE_LABEL@"sv;
	inline constexpr auto EDITION = "@TRP_EDITION@"sv;
	inline constexpr auto SOURCE_REVISION = "@TRP_SOURCE_REVISION@"sv;
	inline constexpr auto BUILD_IDENTITY = "TRP_BUILD|edition=@TRP_EDITION@|source=@TRP_SOURCE_REVISION@|FSR=@TRP_BUILD_FSR@|FG=@TRP_BUILD_FSR_FG@|NR=@TRP_BUILD_NEURAL_RENDERING@"sv;
}
